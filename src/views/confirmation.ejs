<!doctype html>
<html>

<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <title>Bera Korean - Email Verification</title>
  <style>
    /* 기본 스타일 */
    body {
      background-color: #f6f9fc;
      font-family: 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
      -webkit-font-smoothing: antialiased;
      font-size: 16px;
      line-height: 1.4;
      margin: 0;
      padding: 0;
      -ms-text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
    }

    /* 메인 컨테이너 */
    .container {
      background-color: #ffffff;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      margin: 40px auto;
      max-width: 580px;
      padding: 32px;
    }

    /* 로고 영역 */
    .logo {
      text-align: center;
      margin-bottom: 24px;
    }

    .logo img {
      height: 48px;
    }

    /* 제목 */
    h1 {
      color: #1a1a1a;
      font-size: 24px;
      font-weight: 700;
      text-align: center;
      margin: 0 0 24px;
    }

    /* 본문 */
    p {
      color: #4a4a4a;
      font-size: 16px;
      line-height: 1.6;
      margin: 0 0 16px;
    }

    /* 버튼 */
    .button {
      background-color: #4F46E5;
      border-radius: 8px;
      color: #ffffff;
      display: inline-block;
      font-size: 16px;
      font-weight: 600;
      margin: 24px 0;
      padding: 12px 24px;
      text-decoration: none;
      text-align: center;
      transition: background-color 0.2s;
    }

    .button:hover {
      background-color: #4338CA;
    }

    /* 푸터 */
    .footer {
      color: #6b7280;
      font-size: 14px;
      text-align: center;
      margin-top: 32px;
      padding-top: 16px;
      border-top: 1px solid #e5e7eb;
    }

    /* 반응형 디자인 */
    @media only screen and (max-width: 620px) {
      .container {
        margin: 20px 10px;
        padding: 24px;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="logo">
      <!-- 로고 이미지 추가 -->
      <img src="https://beko-s3.s3.ap-northeast-2.amazonaws.com/keojak_iOS+Icon_B(1024_1024).png"
        alt="Bera Korean Logo">
    </div>

    <h1>Welcome to Bera Korean!</h1>

    <p>Hello,</p>
    <p>Thank you for registering with Bera Korean. Please click the button below to verify your email address.</p>

    <div style="text-align: center;">
      <a href="<%= url %>" class="button">Verify Email</a>
    </div>

    <p>If the button does not work, please copy and paste the link below into your browser:</p>
    <p style="word-break: break-all; color: #6b7280;">
      <%= url %>
    </p>

    <p>If you did not create an account, please ignore this email.</p>

    <div class="footer">
      <p>© 2024 Bera Korean. All rights reserved.</p>
      <p>Seoul, South Korea</p>
    </div>
  </div>
</body>

</html>